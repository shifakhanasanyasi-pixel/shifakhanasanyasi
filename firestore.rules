rules_version = '2';

// ============================================================
// FIRESTORE SECURITY RULES
// Deploy with: firebase deploy --only firestore:rules
//
// Important: these rules only govern DIRECT access to Firestore from the
// browser (e.g. if you ever add client-side Firestore reads). All the
// admin writes in this project go through API routes using the Admin SDK,
// which BYPASSES these rules entirely by design (that's what "admin" SDK
// means) — access control for those routes is enforced by requireAdmin()
// in the API route code, not by these rules. These rules are the safety
// net for anything read directly from the browser.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/adminProfiles/$(request.auth.uid));
    }

    match /products/{productId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /mediaItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminProfiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }
  }
}
