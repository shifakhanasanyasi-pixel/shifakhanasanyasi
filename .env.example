# ============================================================
# Copy this file to .env (for local dev) — and separately add every
# one of these same values into your Vercel project's Environment
# Variables settings before deploying (Vercel doesn't read this file).
# NEVER commit the real .env file — .gitignore already covers it.
# ============================================================

# ---- Client-side config (safe to expose to the browser) ----
# Firebase Console → Project Settings → General → scroll to "Your apps" →
# Web app → these are shown directly (or click the config icon).
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcdef"

# ---- Server-side only (NEVER expose these to the browser) ----
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key → downloads a JSON file. Copy three fields from it below.
# For FIREBASE_PRIVATE_KEY: copy the whole "private_key" value from the
# JSON file INCLUDING the \n characters exactly as they appear — don't
# convert them to real newlines yourself, the code does that automatically.
# In Vercel's dashboard, paste it the same way, as one single-line value
# with literal \n characters (not actual line breaks).
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
